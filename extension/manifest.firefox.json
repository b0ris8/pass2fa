{
  "manifest_version": 3,
  "name": "pass2fa",
  "version": "0.3.0",
  "description": "Заполнение логинов и TOTP из локального pass2fa (native messaging, без сети и аккаунтов)",
  "browser_specific_settings": {
    "gecko": {
      "id": "pass2fa@b0ris8",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "background": {
    "scripts": [
      "common.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "pass2fa",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Открыть pass2fa"
    },
    "fill-login": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Заполнить логин для этого сайта"
    },
    "fill-totp": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Вставить TOTP-код для этого сайта"
    }
  }
}
