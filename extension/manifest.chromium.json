{
  "manifest_version": 3,
  "name": "pass2fa",
  "version": "0.3.1",
  "description": "Заполнение логинов и TOTP из локального pass2fa (native messaging, без сети и аккаунтов)",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "pass2fa",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Открыть pass2fa"
    },
    "fill-login": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Заполнить логин для этого сайта"
    },
    "fill-totp": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Вставить TOTP-код для этого сайта"
    }
  }
}
